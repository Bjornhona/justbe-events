NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=2026-08-21

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://b-events.es
NEXT_PUBLIC_SITE_LIVE=false

# Closes the public site: "coming-soon" (200) or "maintenance" (503).
# Anything else, including unset, serves the normal site.
# Set in Vercel (Production); left empty here so local dev sees the real site.
SITE_GATE=

# Secret for the gate bypass: /api/preview?key=<this> sets a cookie that lets
# you past, /api/preview?key=off clears it. Unset means the route 404s.
# Set in Vercel (Production). Never commit a real value, never link to it.
PREVIEW_KEY=

# --- HubSpot (Sprint 3) ---
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
