NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=2026-08-21

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://b-events.es
NEXT_PUBLIC_SITE_LIVE=false

# Closes the public site: "coming-soon" (200) or "maintenance" (503).
# Anything else, including unset, serves the normal site.
# Set in Vercel (Production); left empty here so local dev sees the real site.
SITE_GATE=

# The password for the gate bypass — this is the one you give the client, not a
# URL key. She enters it on /gate/access, which sets a cookie that lets her
# past; /api/preview?key=off clears it. Unset means no password works.
# Set in Vercel (Production). Never commit a real value.
PREVIEW_KEY=

# --- HubSpot (Sprint 3) ---
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
